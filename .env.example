# Copy to .env locally, or add these keys in Render Dashboard → Environment
# Never commit .env (it contains secrets).

# Required for production
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=your-long-random-secret-string

# Alpaca (market data)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Cap MC Alpaca provider in-memory historical cache keys (default 400; min 32)
# MC_ALPACA_HISTORICAL_CACHE_MAX=400
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional – HTTP JSON body limit (default 10mb; raise if a route needs huge JSON)
# JSON_BODY_LIMIT=50mb

# OpenAI (Big Idea, Sentinel AI, synthesis, uploads, pattern-learning)
AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Optional – Start Here mini charts (set false for legacy hardcoded MA overlays)
# VITE_MINI_MA_SETTINGS=false

# FMP_API_KEY=
# FINNHUB_API_KEY=
# TIINGO_API_KEY=

# Alerts delivery providers
# Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MY_ALERT_SMS_NUMBER=
#
# SendGrid email
# SENDGRID_API_KEY=
# ALERTS_FROM_EMAIL=alerts@yourdomain.com
# MY_ALERT_EMAIL=you@yourdomain.com

# PORT is set automatically by Render; omit or set for local dev (e.g. 5000)
